<div class="flex items-center justify-center min-h-screen bg-gray-100 dark:bg-gray-900">
    <div class="w-full max-w-lg bg-white rounded-lg shadow-lg p-6 dark:bg-gray-800">
      <h1 class="text-2xl font-bold text-center text-gray-900 dark:text-white mb-6">Editar País</h1>
      <form action="/countries/<%= country._id %>?_method=PUT" method="POST">
        <input type="hidden" name="_method" value="PUT">
        <div class="mb-4">
          <label for="officialName" class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">Nombre Oficial:</label>
          <input type="text" id="officialName" name="name[official]" value="<%= country.name.official %>" class="w-full px-4 py-2 border rounded-lg text-gray-900 bg-gray-50 dark:bg-gray-700 dark:text-gray-300 dark:border-gray-600 focus:ring-blue-500 focus:border-blue-500" required>
        </div>
        <div class="mb-4">
          <label for="capital" class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">Capital:</label>
          <input type="text" id="capital" name="capital" value="<%= country.capital %>" class="w-full px-4 py-2 border rounded-lg text-gray-900 bg-gray-50 dark:bg-gray-700 dark:text-gray-300 dark:border-gray-600 focus:ring-blue-500 focus:border-blue-500" required>
        </div>
        <div class="mb-4">
          <label for="borders" class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">Fronteras (separadas por comas):</label>
          <input type="text" id="borders" name="borders" value="<%= country.borders %>" class="w-full px-4 py-2 border rounded-lg text-gray-900 bg-gray-50 dark:bg-gray-700 dark:text-gray-300 dark:border-gray-600 focus:ring-blue-500 focus:border-blue-500">
        </div>
        <div class="mb-4">
          <label for="area" class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">Área:</label>
          <input type="number" id="area" name="area" value="<%= country.area %>" class="w-full px-4 py-2 border rounded-lg text-gray-900 bg-gray-50 dark:bg-gray-700 dark:text-gray-300 dark:border-gray-600 focus:ring-blue-500 focus:border-blue-500">
        </div>
        <div class="mb-4">
          <label for="population" class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">Población:</label>
          <input type="number" id="population" name="population" value="<%= country.population %>" class="w-full px-4 py-2 border rounded-lg text-gray-900 bg-gray-50 dark:bg-gray-700 dark:text-gray-300 dark:border-gray-600 focus:ring-blue-500 focus:border-blue-500">
        </div>
        <div class="mb-4">
          <label for="creador" class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-2">Creador:</label>
          <input type="text" id="creador" name="creador" value="<%= country.creador %>" class="w-full px-4 py-2 border rounded-lg bg-gray-200 text-gray-700 dark:bg-gray-700 dark:text-gray-300 dark:border-gray-600" readonly required>
        </div>
        <button type="submit" class="w-full bg-blue-600 text-white py-2 px-4 rounded-lg hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 dark:focus:ring-blue-800">Guardar Cambios</button>
      </form>
      <a href="/countries" class="w-full mt-4 inline-block text-center text-blue-600 dark:text-blue-400 hover:underline">Cancelar</a>
    </div>
  </div>